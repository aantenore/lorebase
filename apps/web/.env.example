# Copy to .env (git-ignored) and adjust. Vite reads these at build/start time; at run time the
# app overlays public/config.js (window.__LOREBASE_CONFIG__) on top, see README "Configuration".

# Data source: "mock" runs against an in-memory sample Domain (no backend needed),
# "live" talks to Keeper over REST.
VITE_API_MODE=mock

# Keeper base URL, without the /api/v1 suffix. Required when VITE_API_MODE=live.
# Documented default for a local Keeper:
VITE_KEEPER_BASE_URL=http://localhost:8080

# Guide (the optional exploration assistant) base URL, e.g. http://localhost:8095. Leave it unset
# to keep the assistant off. Guide lists this app's origin in guide.http.allowed_origins.
# VITE_GUIDE_URL=

# API key (lbk_...) or OIDC access token for Keeper, sent as "Authorization: Bearer". Leave it
# unset when Keeper runs with keeper.auth.mode: none. DEVELOPMENT ONLY: a VITE_ variable ends
# up in the bundle. The token typed in Settings (kept in local storage) takes precedence.
# VITE_API_TOKEN=

# How a live app authenticates: "token" (default) sends the API token above as a Bearer header;
# "session" signs in through Keeper (OIDC login, cookie session, needs keeper.auth.sessions
# enabled on the Keeper) and ignores VITE_API_TOKEN. Ignored in mock mode.
# VITE_AUTH_MODE=token

# Optional tunables. Leave unset to use the built-in non-functional defaults.
# VITE_PAGE_SIZE=50
# VITE_SEARCH_LIMIT=20
# VITE_CANVAS_DEPTH=2
# VITE_CANVAS_MAX_NODES=200
# VITE_CANVAS_LAYOUT_ITERATIONS=100
# VITE_CANVAS_PRELAYOUT_MAX_NODES=500
# VITE_CANVAS_LAYOUT_TIME_BUDGET_MS=20000
# VITE_CANVAS_LAYOUT_SAMPLE_MS=500
# VITE_CANVAS_LAYOUT_CONVERGENCE=0.01
# VITE_CANVAS_LAYOUT_STABLE_SAMPLES=3
# VITE_CANVAS_BARNES_HUT_MIN_NODES=1000
# VITE_CANVAS_LABELS_MAX_NODES=300
# VITE_CANVAS_DENSE_LABEL_MIN_SIZE=14
# VITE_CANVAS_EDGE_LABELS_MAX_EDGES=300
# VITE_CANVAS_HIDE_EDGES_ON_MOVE_MIN_EDGES=2000
# VITE_CANVAS_LIST_MAX_EDGES=500
# Mock only: serve a generated graph from every neighborhood query (performance runs).
# VITE_MOCK_PERF_NODES=5000
# VITE_MOCK_PERF_EDGES=10000
# VITE_QUERY_STALE_MS=30000
# VITE_TOAST_MS=5000
# VITE_MOCK_LATENCY_MS=0
# VITE_SCHEMA_BRANCH_PREFIX=schema/

# "Start from data" in the Modeler. Keep the caps equal to keeper.schema_inference on the Keeper.
# VITE_INFER_MAX_FILES=50
# VITE_INFER_MAX_FILE_BYTES=1048576
# VITE_INFER_MAX_TOTAL_BYTES=1048576
# VITE_INFER_FILE_SUFFIXES=.csv,.tsv,.txt,.json,.jsonl,.ndjson,.parquet
# Confidence from which "Accept all above" accepts an element (0 to 1).
# VITE_INFER_ACCEPT_THRESHOLD=0.9
# Secret references offered for Postgres inference (the allowlist lives on the Keeper).
# VITE_INFER_POSTGRES_SOURCES=secret://env/ERP_DSN

# Documents (intake for extraction). Keep the caps equal to keeper.documents on the Keeper.
# VITE_DOCUMENTS_MAX_FILES=20
# VITE_DOCUMENTS_MAX_FILE_BYTES=20971520
# VITE_DOCUMENTS_FILE_SUFFIXES=.md,.markdown,.txt,.pdf,.docx
# Tiers preselected for an extraction: 0 rules, 1 local models, 2 the chat model.
# VITE_DOCUMENTS_TIERS=0,1
# VITE_DOCUMENTS_EXTRACT_ON_UPLOAD=true
# Offer intake by URL (Keeper fetches only hosts of keeper.documents.url_hosts).
# VITE_DOCUMENTS_URL_INTAKE=true
# VITE_DOCUMENTS_JOB_POLL_MS=3000

# Extraction items in Review: threshold of "Accept at or above" (0 to 1) and items per page.
# VITE_EXTRACTION_ACCEPT_THRESHOLD=0.9
# VITE_EXTRACTION_ITEMS_PAGE_SIZE=200
