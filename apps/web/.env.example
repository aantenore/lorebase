# Copy to .env (git-ignored) and adjust. Every value is read at build/start time by Vite.

# Data source: "mock" runs against an in-memory sample Domain (no backend needed),
# "live" talks to Keeper over REST.
VITE_API_MODE=mock

# Keeper base URL, without the /api/v1 suffix. Required when VITE_API_MODE=live.
# Documented default for a local Keeper:
VITE_KEEPER_BASE_URL=http://localhost:8080

# Optional tunables. Leave unset to use the built-in non-functional defaults.
# VITE_PAGE_SIZE=50
# VITE_SEARCH_LIMIT=20
# VITE_CANVAS_DEPTH=2
# VITE_CANVAS_MAX_NODES=200
# VITE_QUERY_STALE_MS=30000
# VITE_MOCK_LATENCY_MS=0
