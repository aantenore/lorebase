# Lorebase environment for docker compose.
#
#   cp .env.example .env
#   docker compose --env-file .env -f deploy/compose/docker-compose.yaml up -d
#
# Run the commands from the repository root. `.env` is ignored by git; keep real credentials
# there and never commit them. Variables left out use the defaults shown here. Settings of the
# application itself are read from a mounted YAML file and from LOREBASE__SECTION__KEY
# variables (see config/lorebase.example.yaml); only deployment values live in this file.

# Compose project name: prefixes containers, networks and volumes. Give each checkout or stack
# on the same machine its own name, so that two stacks never share containers or data.
COMPOSE_PROJECT_NAME=lorebase
# Extra compose files, separated by spaces and relative to the repository root, that `make up`,
# `make logs`, `make down` and scripts/quickstart.sh add after their own files, for example a
# hosted model whose key is a compose secret (docs/inference-providers.md):
#   COMPOSE_OVERLAYS=deploy/compose/hosted-model.yaml secrets/my-model.yaml
COMPOSE_OVERLAYS=

# ---- Images -------------------------------------------------------------------------------
# Image built from deploy/docker/backend.Dockerfile by `docker compose build`, or pulled.
LOREBASE_IMAGE=lorebase
LOREBASE_TAG=dev
# build: every `docker compose up` rebuilds the images from this checkout (unchanged layers come
# from the cache), so an older image with the same tag never runs against a newer database.
# missing or always: use prebuilt images named by the *_IMAGE and LOREBASE_TAG values instead
# (pulled when absent, or on every up).
LOREBASE_PULL_POLICY=build
# Extra `uv sync` arguments when the images are built, to include the optional tier 1 models
# (GLiNER and GLiREL extractors; large download). Empty: none.
#   UV_SYNC_ARGS=--extra local-extractors
UV_SYNC_ARGS=
# Scribe and Guide run on a second image, target `backend-ml` of the same Dockerfile: the backend
# image plus fastembed and one embedding model downloaded at build time (about 390 MB more).
LOREBASE_ML_IMAGE=lorebase-ml
# Model baked into that image (fastembed name; keep inference.embeddings.model and dims in step).
# Set it empty to bake none: the model then downloads on first use, which needs a writable
# inference.embeddings.cache_dir (a volume) because the root file system is read-only.
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
# Postgres 16 with the pgvector extension.
POSTGRES_IMAGE=pgvector/pgvector:pg16

# ---- Postgres -----------------------------------------------------------------------------
POSTGRES_USER=lorebase
POSTGRES_DB=lorebase
# Required. Change me. Use URL-safe characters: the value is embedded in the connection string.
# This role is a superuser: it owns the schema and runs the migrations and index maintenance.
POSTGRES_PASSWORD=change-me
# Role Keeper and Scribe connect as: no superuser, no BYPASSRLS, so row-level security applies
# (created or updated by the one-shot `db-roles` on every start; see docs/deployment.md).
# Must differ from POSTGRES_USER.
LOREBASE_APP_USER=lorebase_app
# Required. URL-safe, for example: openssl rand -hex 24
LOREBASE_APP_PASSWORD=
# Published on the host for local tools; 127.0.0.1 keeps it private to this machine. Change
# POSTGRES_HOST_PORT when another Postgres already listens on 5432 ("port is already allocated").
POSTGRES_BIND=127.0.0.1
POSTGRES_HOST_PORT=5432
# Where `alembic upgrade head` runs inside the image (alembic.ini lives there).
MIGRATIONS_DIR=/opt/lorebase/store

# ---- Storage profile ----------------------------------------------------------------------
# compact | balanced | fast (store.storage.profile, docs/performance.md#storage-profiles):
# what the database keeps, traded against memory and disk. After a change run
#   docker compose --profile maintenance run --rm storage apply
LOREBASE_STORAGE_PROFILE=balanced
# Postgres memory (docs/performance.md#sizing). Empty: the Postgres defaults (128MB, 4GB, try).
# Starting points per profile on a machine with M of RAM for Postgres:
#   compact:  shared_buffers M/8,  effective_cache_size M/2
#   balanced: shared_buffers M/4,  effective_cache_size 3M/4
#   fast:     shared_buffers 2M/5, effective_cache_size 3M/4, huge pages on, and
#             POSTGRES_PRELOAD_LIBRARIES=pg_prewarm (autoprewarm after restarts)
POSTGRES_SHARED_BUFFERS=
POSTGRES_EFFECTIVE_CACHE_SIZE=
# try | on | off. `on` needs huge pages reserved on the host (vm.nr_hugepages).
POSTGRES_HUGE_PAGES=
POSTGRES_PRELOAD_LIBRARIES=
# /dev/shm of the Postgres container (parallel queries); raise it with shared_buffers.
POSTGRES_SHM_SIZE=256m

# ---- Keeper -------------------------------------------------------------------------------
# Port inside the container (keeper.port) and the address and port published on the host.
# Change KEEPER_HOST_PORT when 8080 is taken, and use the same port in LOREBASE_URL.
KEEPER_PORT=8080
KEEPER_BIND=127.0.0.1
KEEPER_HOST_PORT=8080
# keeper.auth.allow_insecure: lets the example configuration (auth.mode none) listen inside the
# container. Set false, with an api_key or oidc mode, before changing KEEPER_BIND.
KEEPER_ALLOW_INSECURE=true
# YAML mounted at /etc/lorebase/lorebase.yaml; copy config/lorebase.example.yaml to customise.
LOREBASE_CONFIG_FILE=../../config/lorebase.example.yaml
LOG_LEVEL=INFO
# Read replicas for the Keepers (profile scale-out; see docs/deployment.md). Empty: every read
# uses the primary. A comma-separated list spreads reads round-robin. With the profile, use the
# application role (it exists on the replica too):
#   LOREBASE_DB_READ_DSN=postgresql+asyncpg://${LOREBASE_APP_USER}:${LOREBASE_APP_PASSWORD}@postgres-replica:5432/${POSTGRES_DB}
LOREBASE_DB_READ_DSN=
# true: read endpoints use the replicas when one is fresh enough (keeper.reads.prefer_replica).
KEEPER_PREFER_REPLICA=false
# Required. Seals the webhook signing keys stored in the database (webhooks.encryption_key);
# Keeper and Scribe share it. At least 32 characters, for example: openssl rand -hex 32
# (`make env` generates it). Keep it: a lost key cannot open the signing keys sealed under it;
# rotate through webhooks.previous_encryption_keys (docs/operations.md).
LOREBASE_WEBHOOK_KEY=
# Role that runs per-Attribute index DDL for the job worker. Unset, the stack uses the owner
# role above (POSTGRES_USER), which also runs the migrations; production uses a dedicated
# owner role or none.
# LOREBASE_DB_MAINTENANCE_DSN=

# ---- Web app ------------------------------------------------------------------------------
# Built from deploy/docker/web.Dockerfile and started by `make up`: http://127.0.0.1:LOREBASE_WEB_PORT.
# nginx serves the app and forwards /api/ to Keeper (and /guide/ to Guide) on the compose network,
# so the browser uses one origin and Keeper needs no CORS setting. Change LOREBASE_WEB_PORT when
# 8090 is taken. Keep WEB_BIND on 127.0.0.1 while Keeper runs with auth mode none.
LOREBASE_WEB_PORT=8090
WEB_BIND=127.0.0.1
LOREBASE_WEB_IMAGE=lorebase-web
# Guide's path on the web origin. `make up PROFILES=assistant` uses /guide when this is empty; with
# plain compose and the assistant profile set it to /guide. Without the profile it stays empty
# (no assistant in the app).
WEB_GUIDE_URL=
# token (an API key pasted in Settings) or session (browser sign-in, needs keeper.auth.sessions).
WEB_AUTH_MODE=token
# Overlay deploy/compose/oidc-mock.yaml (session sign-in against a mock provider, local only):
# key of the session cookies (openssl rand -base64 48) and the provider's loopback port.
# LOREBASE_SESSION_KEY=
# OIDC_MOCK_PORT=8096
# Largest request body forwarded to Keeper (document uploads), and the proxy timeouts. The read
# timeout also bounds an event stream between two messages.
WEB_PROXY_MAX_BODY=25m
WEB_PROXY_CONNECT_TIMEOUT=3s
WEB_PROXY_READ_TIMEOUT=300s
# Strict-Transport-Security value when TLS is terminated in front of the web service; empty: off.
WEB_HSTS=

# ---- Scribe -------------------------------------------------------------------------------
# Jobs run at the same time by the worker (scribe.worker.concurrency).
SCRIBE_CONCURRENCY=2
# Time given to running jobs on shutdown; keep it above scribe.worker.shutdown_grace_s plus
# scribe.worker.shutdown_cancel_s, or the jobs still running are left to the stale-job reclaim.
SCRIBE_STOP_GRACE=45s
# Host directory mounted read-only at /data/sources/supply for CSV Sources.
SCRIBE_SOURCES_DIR=../../examples/supply/data
# Values behind the example Sources' connection references (examples/supply/schema.yaml).
SUPPLY_APPROVED_SUPPLIERS_CSV=/data/sources/supply/supplier.csv
# Read-only DSN of the ERP database of erp.purchase_orders; empty until you have one.
ERP_DSN=

# ---- Telemetry ----------------------------------------------------------------------------
# Empty disables export. With the `observability` profile use http://otel-collector:4317.
OTLP_ENDPOINT=
OTEL_SAMPLE_RATIO=0.1

# ---- Profile scale-out: second Keeper, Postgres replica, reverse proxy ----------------------
# Rate limit buckets of the Keepers (keeper.limits.rate.backend): local keeps them per Keeper, so
# two Keepers allow twice the limits; set postgres with this profile to share them.
KEEPER_RATE_LIMIT_BACKEND=local
# The replica streams from the primary through a dedicated role and replication slot.
REPLICATION_USER=replicator
# Required with the profile. Change me. Use URL-safe characters.
REPLICATION_PASSWORD=change-me
REPLICATION_SLOT=lorebase_replica_1
POSTGRES_REPLICA_BIND=127.0.0.1
POSTGRES_REPLICA_HOST_PORT=5433
# Unprivileged nginx; the proxy is the entry point of the Keepers (host port below).
PROXY_IMAGE=nginxinc/nginx-unprivileged:1.27-alpine@sha256:65e3e85dbaed8ba248841d9d58a899b6197106c23cb0ff1a132b7bfe0547e4c0
PROXY_BIND=127.0.0.1
PROXY_HOST_PORT=8088
# Larger than keeper.limits.max_request_body_bytes, so that Keeper answers with its own error.
PROXY_MAX_BODY=2m
PROXY_CONNECT_TIMEOUT=3s
PROXY_READ_TIMEOUT=60s

# ---- Model endpoint used by Scribe and `inference-check` ----------------------------------
# Defaults point at the Ollama service of the profile below, inside the compose network. For a
# hosted OpenAI-compatible endpoint or the LiteLLM proxy (http://litellm:4000/v1) change these
# three values only; see docs/inference-providers.md. Leave LLM_API_KEY empty for local servers.
# LLM_MODEL defaults to OLLAMA_MODEL (below); set it to name a model of another endpoint.
# Ollama running on the host instead of in compose: http://host.docker.internal:11434/v1
# (on Linux, Ollama must listen beyond loopback: OLLAMA_HOST=0.0.0.0).
# A hosted key kept in a file: deploy/compose/hosted-model.yaml.
LLM_BASE_URL=http://ollama:11434/v1
# LLM_MODEL=
LLM_API_KEY=

# ---- Profile assistant: Guide, the exploration assistant ----------------------------------
# Uses the model endpoint above (LLM_*). It holds no Keeper credential: it forwards the caller's
# own Authorization or session cookie to Keeper.
GUIDE_PORT=8095
GUIDE_BIND=127.0.0.1
GUIDE_HOST_PORT=8095
# JSON list of browser origins allowed to call Guide (CORS and Origin check). Unset: the origins of
# the web service (http://127.0.0.1 and http://localhost on LOREBASE_WEB_PORT). A list replaces
# those origins, so for the dev server list them with its own: ["http://localhost:5173",
# "http://127.0.0.1:8090"]. An empty list ([]) is treated as unset, with a warning in Guide's log.
# GUIDE_ALLOWED_ORIGINS=
# Accept calls without credentials. Only for the auth mode none development stack: unset, it is
# false in the main compose file and true with the overlay of `make up PROFILES=assistant`.
# GUIDE_ALLOW_ANONYMOUS=false

# ---- Profile local-models: Ollama ---------------------------------------------------------
# Model pulled at start by `ollama-pull`; LLM_MODEL above follows it by default.
OLLAMA_MODEL=qwen2.5:7b-instruct
OLLAMA_IMAGE=ollama/ollama:latest
OLLAMA_BIND=127.0.0.1
# Change it when Ollama already runs on the host (it listens on 11434 too).
OLLAMA_HOST_PORT=11434

# ---- Profile litellm: LiteLLM proxy -------------------------------------------------------
LITELLM_IMAGE=ghcr.io/berriai/litellm:main-stable
LITELLM_PORT=4000
LITELLM_BIND=127.0.0.1
LITELLM_HOST_PORT=4000
# Required with the profile: the key clients present to the proxy (also LLM_API_KEY when
# LLM_BASE_URL points at the proxy). `litellm-secrets` refuses to start the proxy while it is
# empty, `change-me` or shorter than 16 characters. Generate one with:
#   printf 'sk-%s\n' "$(openssl rand -hex 24)"
LITELLM_MASTER_KEY=
# Upstream provider in LiteLLM notation (<provider>/<model>) and its credential. Set the
# credential in your own .env only; never commit it.
LITELLM_UPSTREAM_MODEL=
LITELLM_UPSTREAM_API_KEY=
# Second provider, used by deploy/compose/litellm.two-providers.yaml as fallback. Select that
# file with LITELLM_CONFIG_FILE=./litellm.two-providers.yaml (relative to deploy/compose).
LITELLM_SECONDARY_MODEL=
LITELLM_SECONDARY_API_KEY=
LITELLM_CONFIG_FILE=./litellm.yaml

# ---- Profile observability ----------------------------------------------------------------
OTEL_COLLECTOR_IMAGE=otel/opentelemetry-collector-contrib:latest
JAEGER_IMAGE=jaegertracing/all-in-one:latest
PROMETHEUS_IMAGE=prom/prometheus:latest
GRAFANA_IMAGE=grafana/grafana:latest
PROMETHEUS_RETENTION=7d
OTEL_BIND=127.0.0.1
OTEL_GRPC_HOST_PORT=4317
OTEL_HTTP_HOST_PORT=4318
JAEGER_BIND=127.0.0.1
JAEGER_UI_HOST_PORT=16686
PROMETHEUS_BIND=127.0.0.1
PROMETHEUS_HOST_PORT=9090
GRAFANA_BIND=127.0.0.1
GRAFANA_HOST_PORT=3000
GRAFANA_ADMIN_USER=admin
# Required with the profile; `grafana-secrets` refuses to start Grafana while it is empty,
# `change-me` or shorter than 16 characters. Generate one with: openssl rand -base64 24
GRAFANA_ADMIN_PASSWORD=
