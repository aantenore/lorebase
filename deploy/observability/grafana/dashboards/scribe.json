        "type": "prometheus",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (status) (rate(lorebase_scribe_jobs_total{type=\"source_sync\"}[$__rate_interval]))",
          "legendFormat": "{{status}}"
