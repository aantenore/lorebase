      "id": 21,
      "type": "timeseries",
      "title": "Extraction items per second by tier and decision",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 54
      },
      "description": "Items an extraction job proposes. accepted: accepted at once by the confidence rules; pending: left for review. tier none: items without a tier.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (tier, decision) (rate(lorebase_extraction_items_total[$__rate_interval]))",
          "legendFormat": "tier {{tier}} {{decision}}"
