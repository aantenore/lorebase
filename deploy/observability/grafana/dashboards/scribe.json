      "title": "Source rows read per second",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 46
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (lorebase_source) (rate(lorebase_scribe_source_rows_total[$__rate_interval]))",
          "legendFormat": "{{lorebase_source}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "rowsps",
          "custom": {
