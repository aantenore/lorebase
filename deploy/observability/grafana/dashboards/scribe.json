      "title": "Extraction runs per second by status",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 54
      },
      "description": "Extraction throughput at the level of jobs; items are not counted.",
      "datasource": {
        "type": "prometheus",
