{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Values of the Lorebase chart",
  "description": "Every key is documented in values.yaml. `config` (the application settings) and `postgresql` (the CloudNativePG subchart) stay open; everything else is closed.",
  "type": "object",
  "definitions": {
    "stringMap": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "k8sObject": {
      "type": "object",
      "description": "A Kubernetes object, passed through unchanged."
    },
    "k8sList": {
      "type": "array",
      "items": {
        "type": "object"
      },
      "description": "A list of Kubernetes objects, passed through unchanged."
    },
    "port": {
      "type": "integer",
      "minimum": 1,
      "maximum": 65535
    },
    "command": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1
    },
    "pullPolicy": {
      "type": "string",
      "enum": [
        "Always",
        "IfNotPresent",
        "Never"
      ]
    },
    "image": {
      "type": "object",
      "properties": {
        "repository": {
          "type": "string",
          "minLength": 1
        },
        "tag": {
          "type": [
            "string",
            "number"
          ]
        },
        "pullPolicy": {
          "$ref": "#/definitions/pullPolicy"
        }
      },
      "additionalProperties": false
    },
    "percentOrNull": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 1
    },
    "intOrStringOrNull": {
      "type": [
        "integer",
        "string",
        "null"
      ]
    },
    "strategy": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "RollingUpdate",
            "Recreate"
          ]
        },
        "rollingUpdate": {
          "type": "object"
        }
      },
      "additionalProperties": false
    },
    "probe": {
      "type": "object",
      "description": "A Kubernetes probe; empty disables it."
    },
    "service": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "ClusterIP",
            "NodePort",
            "LoadBalancer"
          ]
        },
        "port": {
          "$ref": "#/definitions/port"
        },
        "annotations": {
          "$ref": "#/definitions/stringMap"
        }
      },
      "additionalProperties": false
    },
    "autoscaling": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "minReplicas": {
          "type": "integer",
          "minimum": 1
        },
        "maxReplicas": {
          "type": "integer",
          "minimum": 1
        },
        "targetCPUUtilizationPercentage": {
          "$ref": "#/definitions/percentOrNull"
        },
        "targetMemoryUtilizationPercentage": {
          "$ref": "#/definitions/percentOrNull"
        },
        "customMetrics": {
          "$ref": "#/definitions/k8sList"
        },
        "behavior": {
          "$ref": "#/definitions/k8sObject"
        }
      },
      "additionalProperties": false
    },
    "pdb": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "minAvailable": {
          "$ref": "#/definitions/intOrStringOrNull"
        },
        "maxUnavailable": {
          "$ref": "#/definitions/intOrStringOrNull"
        }
      },
      "additionalProperties": false
    },
    "networkPeers": {
      "type": "array",
      "items": {
        "type": "object"
      },
      "description": "NetworkPolicyPeer list."
    },
    "networkPorts": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "protocol": {
            "type": "string",
            "enum": [
              "TCP",
              "UDP",
              "SCTP"
            ]
          },
          "port": {
            "type": [
              "integer",
              "string"
            ]
          },
          "endPort": {
            "$ref": "#/definitions/port"
          }
        },
        "additionalProperties": false
      }
    },
    "egressTarget": {
      "type": "object",
      "properties": {
        "to": {
          "$ref": "#/definitions/networkPeers"
        },
        "ports": {
          "$ref": "#/definitions/networkPorts"
        }
      },
      "additionalProperties": false
    }
  },
  "properties": {
    "global": {
      "type": "object",
      "description": "Helm global values, shared with the subchart."
    },
    "nameOverride": {
      "type": "string"
    },
    "fullnameOverride": {
      "type": "string"
    },
    "commonLabels": {
      "$ref": "#/definitions/stringMap"
    },
    "commonAnnotations": {
      "$ref": "#/definitions/stringMap"
    },
    "image": {
      "$ref": "#/definitions/image"
    },
    "imageMl": {
      "type": "object",
      "properties": {
        "repository": {
          "type": "string"
        },
        "tag": {
          "type": [
            "string",
            "number"
          ]
        }
      },
      "additionalProperties": false
    },
    "imagePullSecrets": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "name"
        ],
        "additionalProperties": false
      }
    },
    "serviceAccount": {
      "type": "object",
      "properties": {
        "create": {
          "type": "boolean"
        },
        "name": {
          "type": "string"
        },
        "annotations": {
          "$ref": "#/definitions/stringMap"
        },
        "automount": {
          "type": "boolean"
        }
      },
      "additionalProperties": false
    },
    "podSecurityContext": {
      "$ref": "#/definitions/k8sObject"
    },
    "containerSecurityContext": {
      "$ref": "#/definitions/k8sObject"
    },
    "config": {
      "type": "object",
      "description": "lorebase.yaml of the application (config/lorebase.example.yaml); open, checked by the application.",
      "properties": {
        "keeper": {
          "type": "object",
          "properties": {
            "auth": {
              "type": "object",
              "properties": {
                "mode": {
                  "type": "string",
                  "enum": [
                    "none",
                    "api_key",
                    "oidc",
                    "api_key+oidc"
                  ]
                }
              }
            }
          }
        }
      }
    },
    "logLevel": {
      "type": "string",
      "enum": [
        "CRITICAL",
        "ERROR",
        "WARNING",
        "INFO",
        "DEBUG"
      ]
    },
    "telemetry": {
      "type": "object",
      "properties": {
        "otlpEndpoint": {
          "type": "string"
        },
        "sampleRatio": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      },
      "additionalProperties": false
    },
    "secrets": {
      "type": "object",
      "properties": {
        "existingSecret": {
          "type": "string"
        },
        "keys": {
          "type": "object",
          "properties": {
            "dbDsn": {
              "type": "string"
            },
            "dbMaintenanceDsn": {
              "type": "string"
            },
            "dbReadDsn": {
              "type": "string"
            },
            "apiKeyPepper": {
              "type": "string"
            },
            "llmApiKey": {
              "type": "string"
            },
            "oidcClientSecret": {
              "type": "string"
            },
            "sessionEncryptionKey": {
              "type": "string"
            },
            "webhookEncryptionKey": {
              "type": "string"
            }
          },
          "additionalProperties": false
        },
        "values": {
          "type": "object",
          "properties": {
            "dbDsn": {
              "type": "string"
            },
            "dbMaintenanceDsn": {
              "type": "string"
            },
            "dbAppPassword": {
              "type": "string"
            },
            "dbReadDsn": {
              "type": [
                "string",
                "array"
              ],
              "items": {
                "type": "string"
              }
            },
            "apiKeyPepper": {
              "type": "string"
            },
            "llmApiKey": {
              "type": "string"
            },
            "oidcClientSecret": {
              "type": "string"
            },
            "sessionEncryptionKey": {
              "type": "string"
            },
            "webhookEncryptionKey": {
              "type": "string"
            }
          },
          "additionalProperties": false
        },
        "extra": {
          "type": "object",
          "propertyNames": {
            "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
          },
          "additionalProperties": {
            "type": "string"
          }
        },
        "extraNames": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
          }
        }
      },
      "additionalProperties": false
    },
    "database": {
      "type": "object",
      "properties": {
        "appRole": {
          "type": "object",
          "properties": {
            "name": {
              "type": "string",
              "pattern": "^[a-z_][a-z0-9_]{0,62}$"
            },
            "create": {
              "type": "boolean"
            },
            "passwordSecret": {
              "type": "string"
            }
          },
          "additionalProperties": false
        },
        "setup": {
          "type": "object",
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "waitSeconds": {
              "type": "integer",
              "minimum": 0
            },
            "clusterRoles": {
              "type": "object",
              "properties": {
                "enabled": {
                  "type": "boolean"
                }
              },
              "additionalProperties": false
            }
          },
          "additionalProperties": false
        },
        "maintenanceDsnInKeeper": {
          "type": "boolean"
        },
        "allowSharedRole": {
          "type": "boolean"
        }
      },
      "additionalProperties": false
    },
    "postgresql": {
      "type": "object",
      "description": "CloudNativePG `cluster` subchart values (validated by the subchart); `enabled` switches it on.",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "fullnameOverride": {
          "type": "string"
        }
      },
      "additionalProperties": true
    },
    "migrate": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "hookEvents": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "enum": [
              "pre-install",
              "post-install",
              "pre-upgrade",
              "post-upgrade",
              "pre-delete",
              "post-delete",
              "pre-rollback",
              "post-rollback"
            ]
          }
        },
        "hookEventsInCluster": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "enum": [
              "pre-install",
              "post-install",
              "pre-upgrade",
              "post-upgrade",
              "pre-delete",
              "post-delete",
              "pre-rollback",
              "post-rollback"
            ]
          }
        },
        "hookWeight": {
          "type": "integer"
        },
        "command": {
          "$ref": "#/definitions/command"
        },
        "workingDir": {
          "type": "string",
          "minLength": 1
        },
        "backoffLimit": {
          "type": "integer",
          "minimum": 0
        },
        "activeDeadlineSeconds": {
          "type": "integer",
          "minimum": 1
        },
        "waitForDatabase": {
          "type": "object",
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "timeoutSeconds": {
              "type": "integer",
              "minimum": 1
            },
            "intervalSeconds": {
              "type": "integer",
              "minimum": 1
            }
          },
          "additionalProperties": false
        },
        "serviceAccountName": {
          "type": "string"
        },
        "resources": {
          "$ref": "#/definitions/k8sObject"
        },
        "podAnnotations": {
          "$ref": "#/definitions/stringMap"
        },
        "nodeSelector": {
          "$ref": "#/definitions/stringMap"
        },
        "tolerations": {
          "$ref": "#/definitions/k8sList"
        },
        "affinity": {
          "$ref": "#/definitions/k8sObject"
        },
        "extraEnv": {
          "$ref": "#/definitions/k8sList"
        }
      },
      "additionalProperties": false
    },
    "keeper": {
      "type": "object",
      "properties": {
