        },
        "extraVolumes": {
          "$ref": "#/definitions/k8sList"
        },
        "livenessProbe": {
          "$ref": "#/definitions/probe"
        },
        "nodeSelector": {
          "$ref": "#/definitions/stringMap"
        },
        "pdb": {
          "$ref": "#/definitions/pdb"
        },
        "podAnnotations": {
          "$ref": "#/definitions/stringMap"
        },
        "podLabels": {
          "$ref": "#/definitions/stringMap"
        },
        "port": {
          "$ref": "#/definitions/port"
        },
        "preStopSleepSeconds": {
          "type": "integer",
          "minimum": 0
        },
        "preferReplica": {
          "type": "boolean"
        },
        "priorityClassName": {
          "type": "string"
        },
        "rateLimitBackend": {
          "type": "string",
