            "",
            "local",
            "postgres"
          ]
        },
        "readinessProbe": {
          "$ref": "#/definitions/probe"
        },
        "replicaCount": {
          "type": "integer",
          "minimum": 0
        },
        "resources": {
          "$ref": "#/definitions/k8sObject"
        },
        "service": {
          "$ref": "#/definitions/service"
        },
        "startupProbe": {
          "$ref": "#/definitions/probe"
        },
        "strategy": {
          "$ref": "#/definitions/strategy"
        },
        "terminationGracePeriodSeconds": {
