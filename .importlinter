[importlinter]
root_packages =
    lorebase_core
    lorebase_platform
    lorebase_inference
    lorebase_store
    lorebase_keeper
    lorebase_client
    lorebase_cli
    lorebase_herald
include_external_packages = False

# Dependency direction (design 17): core depends on nothing internal; store on core and
# platform; inference on core and platform; keeper on store; client on nothing internal;
# cli on client; herald on platform and client, never on inference. Scribe joins these
# contracts when its package is created (M2): it may depend on store and inference. Nothing
# depends on herald.

[importlinter:contract:core-is-pure]
name = core has no internal dependencies
type = forbidden
source_modules =
    lorebase_core
forbidden_modules =
    lorebase_platform
    lorebase_inference
    lorebase_store
    lorebase_keeper
    lorebase_client
    lorebase_cli
    lorebase_herald

[importlinter:contract:platform-is-leaf]
name = platform has no internal dependencies
type = forbidden
source_modules =
    lorebase_platform
forbidden_modules =
    lorebase_core
    lorebase_inference
    lorebase_store
    lorebase_keeper
    lorebase_client
    lorebase_cli
    lorebase_herald

[importlinter:contract:store-layer]
name = store depends on core and platform only
type = forbidden
source_modules =
    lorebase_store
forbidden_modules =
    lorebase_inference
    lorebase_keeper
    lorebase_client
    lorebase_cli
    lorebase_herald

[importlinter:contract:inference-layer]
name = inference depends on core and platform only
type = forbidden
source_modules =
    lorebase_inference
forbidden_modules =
    lorebase_store
    lorebase_keeper
    lorebase_client
    lorebase_cli
    lorebase_herald

[importlinter:contract:keeper-layer]
name = keeper depends on store and never on inference
type = forbidden
source_modules =
    lorebase_keeper
forbidden_modules =
    lorebase_inference
    lorebase_client
    lorebase_cli
    lorebase_herald

[importlinter:contract:client-is-standalone]
name = client has no internal dependencies
type = forbidden
source_modules =
    lorebase_client
forbidden_modules =
    lorebase_core
    lorebase_platform
    lorebase_inference
    lorebase_store
    lorebase_keeper
    lorebase_cli
    lorebase_herald

[importlinter:contract:cli-layer]
name = cli depends on client only
type = forbidden
source_modules =
    lorebase_cli
forbidden_modules =
    lorebase_core
    lorebase_platform
    lorebase_inference
    lorebase_store
    lorebase_keeper
    lorebase_herald

[importlinter:contract:herald-layer]
name = herald depends on platform and client only and never on inference
type = forbidden
source_modules =
    lorebase_herald
forbidden_modules =
    lorebase_core
    lorebase_inference
    lorebase_store
    lorebase_keeper
    lorebase_cli
